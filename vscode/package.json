{
  "name": "isabelle-blueprint-vscode",
  "displayName": "IsabelleBlueprint",
  "description": "Surface IsabelleBlueprint project status in VS Code.",
  "version": "1.10.0",
  "publisher": "isabelle-blueprint",
  "license": "MIT",
  "homepage": "https://github.com/Arthur742Ramos/isa-blueprint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arthur742Ramos/isa-blueprint.git"
  },
  "bugs": {
    "url": "https://github.com/Arthur742Ramos/isa-blueprint/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:isabelle-blueprint.toml",
    "onCommand:isabelleBlueprint.refresh",
    "onCommand:isabelleBlueprint.goToNode",
    "onCommand:isabelleBlueprint.openDashboard",
    "onCommand:isabelleBlueprint.runReport",
    "onCommand:isabelleBlueprint.runCheck",
    "onCommand:isabelleBlueprint.runLint",
    "onCommand:isabelleBlueprint.runGate",
    "onCommand:isabelleBlueprint.runTasks",
    "onCommand:isabelleBlueprint.runRoadmap",
    "onCommand:isabelleBlueprint.runAgentContext",
    "onCommand:isabelleBlueprint.runStaleness",
    "onCommand:isabelleBlueprint.runBurndown",
    "onCommand:isabelleBlueprint.runCriticalPath",
    "onCommand:isabelleBlueprint.openNextTaskPrompt",
    "onCommand:isabelleBlueprint.previewTaskPrompt",
    "onCommand:isabelleBlueprint.explainNode",
    "onCommand:isabelleBlueprint.recordMemory",
    "onLanguage:markdown",
    "onLanguage:latex"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/blueprint.json"
      },
      {
        "language": "latex",
        "path": "./snippets/blueprint-latex.json"
      }
    ],
    "commands": [
      {
        "command": "isabelleBlueprint.refresh",
        "title": "IsabelleBlueprint: Refresh"
      },
      {
        "command": "isabelleBlueprint.openNode",
        "title": "IsabelleBlueprint: Open Node"
      },
      {
        "command": "isabelleBlueprint.goToNode",
        "title": "IsabelleBlueprint: Go to Blueprint Node"
      },
      {
        "command": "isabelleBlueprint.openDashboard",
        "title": "IsabelleBlueprint: Open Dashboard"
      },
      {
        "command": "isabelleBlueprint.runReport",
        "title": "IsabelleBlueprint: Run Report"
      },
      {
        "command": "isabelleBlueprint.runCheck",
        "title": "IsabelleBlueprint: Run Check"
      },
      {
        "command": "isabelleBlueprint.runLint",
        "title": "IsabelleBlueprint: Run Lint"
      },
      {
        "command": "isabelleBlueprint.runGate",
        "title": "IsabelleBlueprint: Run Gate"
      },
      {
        "command": "isabelleBlueprint.runTasks",
        "title": "IsabelleBlueprint: Generate Tasks"
      },
      {
        "command": "isabelleBlueprint.runRoadmap",
        "title": "IsabelleBlueprint: Run Roadmap"
      },
      {
        "command": "isabelleBlueprint.runAgentContext",
        "title": "IsabelleBlueprint: Generate Agent Context"
      },
      {
        "command": "isabelleBlueprint.runStaleness",
        "title": "IsabelleBlueprint: Audit Staleness"
      },
      {
        "command": "isabelleBlueprint.runBurndown",
        "title": "IsabelleBlueprint: Forecast Burndown"
      },
      {
        "command": "isabelleBlueprint.runCriticalPath",
        "title": "IsabelleBlueprint: Show Critical Path"
      },
      {
        "command": "isabelleBlueprint.openNextTaskPrompt",
        "title": "IsabelleBlueprint: Open Next Task Prompt"
      },
      {
        "command": "isabelleBlueprint.previewTaskPrompt",
        "title": "IsabelleBlueprint: Preview Task Prompt"
      },
      {
        "command": "isabelleBlueprint.explainNode",
        "title": "IsabelleBlueprint: Explain Node"
      },
      {
        "command": "isabelleBlueprint.recordMemory",
        "title": "IsabelleBlueprint: Record Node Memory"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "isabelleBlueprint.previewTaskPrompt",
          "when": "view == isabelleBlueprint.nodes && viewItem == isabelleBlueprintNode",
          "group": "inline"
        },
        {
          "command": "isabelleBlueprint.explainNode",
          "when": "view == isabelleBlueprint.nodes && viewItem == isabelleBlueprintNode",
          "group": "navigation"
        },
        {
          "command": "isabelleBlueprint.recordMemory",
          "when": "view == isabelleBlueprint.nodes && viewItem == isabelleBlueprintNode",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "isabelleBlueprint.nodes",
          "name": "Blueprint Nodes"
        }
      ]
    },
    "configuration": {
      "title": "IsabelleBlueprint",
      "properties": {
        "isabelleBlueprint.projectJson": {
          "type": "string",
          "default": "build/project.json",
          "description": "Path to the generated IsabelleBlueprint project JSON, relative to each workspace folder."
        },
        "isabelleBlueprint.cliPath": {
          "type": "string",
          "default": "isabelle-blueprint",
          "description": "Path to the IsabelleBlueprint CLI executable used by Run Report/Check/Tasks commands."
        },
        "isabelleBlueprint.sitePath": {
          "type": "string",
          "default": "site/index.html",
          "description": "Path to the generated static dashboard, relative to each workspace folder. Open Dashboard generates it when missing."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "npm run compile",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "1.120.0",
    "typescript": "^6.0.3"
  }
}

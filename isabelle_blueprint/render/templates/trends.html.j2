{% extends "base.html.j2" %}
{% block content %}
<h1>Trends</h1>

<p class="lede">
  Coverage and problem counts across recent runs of <code>isabelle-blueprint report</code>.
  History is appended to <code>build/trends.json</code> (and shipped as
  <code>trends.json</code> alongside the site) and capped to the most recent
  500 entries.
</p>

{% if trends %}
  <section class="trend-chart" data-trend-chart>
    <div class="trend-chart-host" data-trend-chart-host>
      <p class="trend-chart-empty">Loading chart&hellip;</p>
    </div>
    <div class="trend-chart-legend" data-trend-chart-legend></div>
  </section>

  <section class="trend-table-wrap">
    <h2>History</h2>
    <table class="trend-table">
      <caption class="sr-only">Blueprint coverage and problem history by recorded run.</caption>
      <thead>
        <tr>
          <th scope="col">Recorded</th>
          <th scope="col">Commit</th>
          <th scope="col">Branch</th>
          <th scope="col">Coverage</th>
          <th scope="col">Proved</th>
          <th scope="col">Problems</th>
          <th scope="col">Nodes</th>
        </tr>
      </thead>
      <tbody>
        {% for entry in trends|reverse %}
          <tr>
            <th scope="row">{{ entry.timestamp }}</th>
            <td><code>{{ (entry.commit_sha or 'local')[:8] }}</code></td>
            <td>{{ entry.branch or '-' }}</td>
            <td>{{ '%d%%'|format(entry.coverage_percent) if entry.coverage_percent is not none else '-' }}</td>
            <td>{{ entry.proved_count }}</td>
            <td>{{ entry.problem_count }}</td>
            <td>{{ entry.node_count }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% else %}
  <div class="callout">
    <p><strong>No trend history yet.</strong> Run <code>isabelle-blueprint report</code> to record the first data point.</p>
  </div>
{% endif %}
{% endblock %}

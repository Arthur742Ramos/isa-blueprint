{% extends "base.html.j2" %}
{% block content %}
<h1>Dependency graph</h1>

<p class="lede">
  Each node is colour-coded by its current formal status. Arrows go from a result to the lemmas it depends on.
</p>

{% if has_svg %}
  <div class="graph-toolbar" data-graph-filters>
    <span class="graph-toolbar-label">Show formal status:</span>
    {% for value in formal_status_values %}
      <label class="graph-filter-pill">
        <input
          type="checkbox"
          data-graph-formal="{{ value }}"
          checked
        />
        <span class="graph-filter-swatch" style="background: {{ status_colors.get(value, '#9ca3af') }};" aria-hidden="true"></span>
        <span>{{ value }}</span>
      </label>
    {% endfor %}
    <button type="button" class="graph-filter-reset" data-graph-filters-reset>Reset</button>
    <span class="graph-filter-count" data-graph-filters-count></span>
  </div>
  <div class="graph-frame" data-graph-host>
    {{ svg_source|safe }}
  </div>
  <p class="graph-download">
    <a href="graph.svg">Download SVG</a>
    &middot; <a href="graph.dot">graph.dot</a>
    &middot; <a href="graph.json">graph.json</a>
  </p>
{% else %}
  <div class="graph-frame">
    <div class="callout warning">
      <p><strong>Graphviz is not installed.</strong> Showing raw DOT instead. Install <code>graphviz</code> on PATH to get an inline diagram.</p>
      <pre><code>{{ dot_source|e }}</code></pre>
    </div>
  </div>
{% endif %}

<section>
  <h2>Dependency levels</h2>
  <p class="lede">
    Nodes are grouped by longest dependency distance: level 0 nodes have no known dependencies, and higher levels can build on earlier lanes.
  </p>
  <div class="swimlanes">
    {% for row in dependency_levels %}
      <section class="swimlane {{ 'cycle' if row.is_cycle }}" data-level="{{ row.level if row.level is not none else 'cycle' }}">
        <h3>{{ row.label }} <span>{{ row.count }}</span></h3>
        {% if row.is_cycle %}
          <p class="swimlane-note">Cycle or cycle-dependent path detected; these nodes could not be assigned an acyclic level.</p>
        {% endif %}
        <ul>
          {% for node in row.nodes %}
            <li>
              <a href="nodes/{{ node.id }}.html"><code>{{ node.id }}</code></a>
              <span class="status-pill" style="background: {{ status_colors.get(node.status.formal.value, '#9ca3af') }};">{{ node.status.formal.value }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</section>

<details>
  <summary>Raw DOT source</summary>
  <p><a href="graph.dot">Download <code>graph.dot</code></a> &middot; <a href="graph.json">Download <code>graph.json</code></a></p>
</details>
{% endblock %}


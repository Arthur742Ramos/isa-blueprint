{% extends "base.html.j2" %}
{% block content %}
<h1>Status table</h1>

<section class="status-summary">
  <article>
    <h2>Blueprint</h2>
    {% for item in blueprint_breakdown %}
      <div class="summary-row">
        <span>{{ item.label }}</span>
        <meter min="0" max="100" value="{{ item.percent }}">{{ item.percent }}%</meter>
        <strong>{{ item.count }}</strong>
      </div>
    {% endfor %}
  </article>
  <article>
    <h2>Formal</h2>
    {% for item in formal_breakdown %}
      <div class="summary-row">
        <span>{{ item.label }}</span>
        <meter min="0" max="100" value="{{ item.percent }}">{{ item.percent }}%</meter>
        <strong>{{ item.count }}</strong>
      </div>
    {% endfor %}
  </article>
  <article>
    <h2>Agent</h2>
    {% for item in agent_breakdown %}
      <div class="summary-row">
        <span>{{ item.label }}</span>
        <meter min="0" max="100" value="{{ item.percent }}">{{ item.percent }}%</meter>
        <strong>{{ item.count }}</strong>
      </div>
    {% endfor %}
  </article>
</section>

<section class="filters" aria-label="Filter status table">
  <label class="search-box">
    <span class="filter-label">Search</span>
    <input type="search" data-filter-search placeholder="Search id, title, fact, tags..." />
  </label>
  <div class="filter-row">
    <span class="filter-label">Blueprint</span>
    {% for item in blueprint_breakdown if item.count > 0 %}
      <button type="button" class="filter-pill" data-filter-dim="blueprint" data-filter-value="{{ item.label }}">{{ item.label }} <small>({{ item.count }})</small></button>
    {% endfor %}
  </div>
  <div class="filter-row">
    <span class="filter-label">Formal</span>
    {% for item in formal_breakdown if item.count > 0 %}
      <button type="button" class="filter-pill" data-filter-dim="formal" data-filter-value="{{ item.label }}" style="--pill-accent: {{ item.color }};">{{ item.label }} <small>({{ item.count }})</small></button>
    {% endfor %}
  </div>
  <div class="filter-row">
    <span class="filter-label">Agent</span>
    {% for item in agent_breakdown if item.count > 0 %}
      <button type="button" class="filter-pill" data-filter-dim="agent" data-filter-value="{{ item.label }}">{{ item.label }} <small>({{ item.count }})</small></button>
    {% endfor %}
  </div>
  <div class="filter-row filter-row-actions">
    <button type="button" class="filter-clear" data-filter-clear>Clear filters</button>
    <span class="filter-count"><span data-filter-count>{{ project.nodes|length }} / {{ project.nodes|length }}</span> nodes shown</span>
  </div>
</section>

<table class="status-table">
  <caption class="sr-only">Blueprint nodes and their blueprint, formal, and agent statuses.</caption>
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Kind</th>
      <th scope="col">Title</th>
      <th scope="col">Isabelle fact</th>
      <th scope="col">Blueprint</th>
      <th scope="col">Formal</th>
      <th scope="col">Agent</th>
    </tr>
  </thead>
  <tbody>
    {% for node in project.nodes %}
      <tr data-blueprint="{{ node.status.blueprint.value }}" data-formal="{{ node.status.formal.value }}" data-agent="{{ node.status.agent.value }}" data-search="{{ (node.id ~ ' ' ~ node.title ~ ' ' ~ node.kind.value ~ ' ' ~ (node.isabelle.fact or '') ~ ' ' ~ (node.tags|join(' ')))|lower }}">
        <th scope="row"><a href="nodes/{{ node_filename(node.id) }}"><code>{{ node.id }}</code></a></th>
        <td>{{ node.kind.value }}</td>
        <td>{{ node.title }}</td>
        <td><code>{{ node.isabelle.fact or '' }}</code></td>
        <td>{{ node.status.blueprint.value }}</td>
        <td><span class="status-pill" style="background: {{ status_colors.get(node.status.formal.value, '#9ca3af') }};">{{ node.status.formal.value }}</span></td>
        <td>{{ node.status.agent.value }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ project.name }} - {{ title or page|capitalize }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="{{ static_prefix or 'static/' }}style.css" />
  <script defer src="{{ static_prefix or 'static/' }}filters.js"></script>
  <script defer src="{{ static_prefix or 'static/' }}graph.js"></script>
  <script defer src="{{ static_prefix or 'static/' }}trends.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a class="logo" href="{{ home_prefix or '' }}index.html">{{ project.name }}</a>
      <nav>
        <a href="{{ home_prefix or '' }}index.html" class="{{ 'active' if page == 'index' }}">Overview</a>
        <a href="{{ home_prefix or '' }}graph.html" class="{{ 'active' if page == 'graph' }}">Graph</a>
        <a href="{{ home_prefix or '' }}status.html" class="{{ 'active' if page == 'status' }}">Status</a>
        <a href="{{ home_prefix or '' }}tasks.html" class="{{ 'active' if page == 'tasks' }}">Tasks</a>
        <a href="{{ home_prefix or '' }}trends.html" class="{{ 'active' if page == 'trends' }}">Trends</a>
      </nav>
    </div>
  </header>
  <main class="container">
    {% block content %}{% endblock %}
  </main>
  <footer class="site-footer">
    <div class="container">
      Generated by <strong>IsabelleBlueprint</strong>. Fact exists != proof trusted.
    </div>
  </footer>
</body>
</html>

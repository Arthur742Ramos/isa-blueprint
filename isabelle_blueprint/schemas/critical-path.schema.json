{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/critical-path.schema.json",
  "title": "IsabelleBlueprint critical-path report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "remaining_count",
    "goal_count",
    "longest",
    "goals",
    "bottlenecks",
    "cycles",
    "missing_dependencies",
    "inconsistent"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "remaining_count": { "type": "integer", "minimum": 0 },
    "goal_count": { "type": "integer", "minimum": 0 },
    "longest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/goalChain" }
      ]
    },
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goalChain" }
    },
    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "title", "formal_status", "leverage"],
        "properties": {
          "node_id": { "type": "string" },
          "title": { "type": "string" },
          "formal_status": { "type": "string" },
          "leverage": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "missing_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "missing"],
        "properties": {
          "node_id": { "type": "string" },
          "missing": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "inconsistent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "incomplete_dependencies"],
        "properties": {
          "node_id": { "type": "string" },
          "incomplete_dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "goalChain": {
      "type": "object",
      "required": ["goal_id", "title", "formal_status", "depth", "path"],
      "properties": {
        "goal_id": { "type": "string" },
        "title": { "type": "string" },
        "formal_status": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0 },
        "path": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/graph.schema.json",
  "title": "IsabelleBlueprint dependency graph",
  "type": "object",
  "required": ["name", "nodes", "edges"],
  "properties": {
    "name": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "blueprint_status", "formal_status", "agent_status", "color", "isabelle"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "blueprint_status": { "type": "string" },
          "formal_status": { "type": "string" },
          "agent_status": { "type": "string" },
          "color": { "type": "string" },
          "isabelle": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/scorecard.schema.json",
  "title": "IsabelleBlueprint quality scorecard",
  "type": "object",
  "required": ["schema_version", "project", "score", "grade", "components"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "grade": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "score", "weight", "detail"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "gate": {
      "type": "object",
      "description": "Present when --min-grade and/or --min-score is passed: the CI gate result. The min_grade/meets_min_grade keys appear only with --min-grade, the min_score/meets_min_score keys only with --min-score. A meets_* value is null for an ungradeable (empty) project.",
      "required": ["score", "grade"],
      "anyOf": [
        { "required": ["min_grade"] },
        { "required": ["min_score"] }
      ],
      "properties": {
        "min_grade": { "type": "string" },
        "min_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "grade": { "type": "string" },
        "meets_min_grade": { "type": ["boolean", "null"] },
        "meets_min_score": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "component_gates": {
      "type": "array",
      "description": "Present whenever one or more --min-component NAME=PCT gates are supplied (regardless of whether they pass or fail): one entry per gate. 'score' is the component's percentage (0-100) or null when the component has no defined score; 'meets' is null in that case and never fails the gate.",
      "items": {
        "type": "object",
        "required": ["component", "threshold", "score", "meets"],
        "properties": {
          "component": { "type": "string" },
          "threshold": { "type": "integer", "minimum": 0, "maximum": 100 },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "meets": { "type": ["boolean", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}

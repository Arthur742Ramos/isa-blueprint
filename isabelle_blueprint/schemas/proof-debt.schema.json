{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/proof-debt.schema.json",
  "title": "IsabelleBlueprint proof-debt report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "total_debt",
    "remaining_node_count",
    "buckets",
    "default_effort_used"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "total_debt": { "type": "integer", "minimum": 0 },
    "remaining_node_count": { "type": "integer", "minimum": 0 },
    "default_effort_used": { "type": "boolean" },
    "buckets": {
      "type": "object",
      "required": ["named", "found", "problem", "missing"],
      "properties": {
        "named": { "type": "integer", "minimum": 0 },
        "found": { "type": "integer", "minimum": 0 },
        "problem": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": ["fail_over", "total_debt", "exceeds"],
      "properties": {
        "fail_over": { "type": "integer" },
        "total_debt": { "type": "integer", "minimum": 0 },
        "exceeds": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/tag-cooccurrence.schema.json",
  "title": "IsabelleBlueprint tag co-occurrence report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "min_shared",
    "pair_count",
    "pairs"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "min_shared": { "type": "integer", "minimum": 1 },
    "pair_count": { "type": "integer", "minimum": 0 },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tags", "shared_count", "node_ids"],
        "properties": {
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "shared_count": { "type": "integer", "minimum": 1 },
          "node_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

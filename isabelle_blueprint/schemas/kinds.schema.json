{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/kinds.schema.json",
  "title": "IsabelleBlueprint per-kind coverage report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "total_nodes",
    "kind_count",
    "kinds"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "total_nodes": { "type": "integer", "minimum": 0 },
    "kind_count": { "type": "integer", "minimum": 0 },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "node_count",
          "formal_targets",
          "proved_count",
          "found_count",
          "problem_count",
          "coverage_percent"
        ],
        "properties": {
          "kind": { "type": "string" },
          "node_count": { "type": "integer", "minimum": 0 },
          "formal_targets": { "type": "integer", "minimum": 0 },
          "proved_count": { "type": "integer", "minimum": 0 },
          "found_count": { "type": "integer", "minimum": 0 },
          "problem_count": { "type": "integer", "minimum": 0 },
          "coverage_percent": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

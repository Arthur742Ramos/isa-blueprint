{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Arthur742Ramos.github.io/isa-blueprint/schemas/tasks.schema.json",
  "title": "IsabelleBlueprint agent tasks",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "node_id", "title", "kind", "target_fact", "target_theory", "informal_statement", "informal_proof", "dependencies", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string" },
          "node_id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "target_fact": { "type": ["string", "null"] },
          "target_theory": { "type": ["string", "null"] },
          "informal_statement": { "type": "string" },
          "informal_proof": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "fact", "theory"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "fact": { "type": ["string", "null"] },
                "theory": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "priority": { "type": "string" },
              "difficulty": { "type": "string" },
              "dependency_depth": { "type": "integer" },
              "blocking_count": { "type": "integer" },
              "suggested_order": { "type": "integer" },
              "suggested_facts": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "memory": {
            "type": ["object", "null"],
            "properties": {
              "attempt_count": { "type": "integer" },
              "last_outcome": { "type": ["string", "null"] },
              "last_summary": { "type": ["string", "null"] },
              "last_timestamp": { "type": ["string", "null"] },
              "next_step": { "type": ["string", "null"] },
              "stale": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "suggested_next_task": { "type": ["string", "null"] },
    "filters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "difficulty": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memory_state": {
          "type": "array",
          "items": { "type": "string" }
        },
        "last_outcome": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude_node": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "ready_task_count": { "type": "integer" },
    "filtered_ready_task_count": { "type": "integer" }
  },
  "additionalProperties": true
}
